<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="USB-B01">
 <version>4</version>
 <date>2026-09-15</date>
 <label>J</label>
 <author>fritzing-parts-langhua</author>
 <title>USB Type-B Receptacle, right-angle (SOFNG SOF-G006)</title>
 <tags>
  <tag>USB-B (right-angle)</tag>
  <tag>USB</tag>
 </tags>
 <properties>
  <property name="package">USB-B (right-angle)</property>
  <property name="family">USB Connector</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/USB-B01_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/USB-B01_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/USB-B01_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/USB-B01_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector id="connector0" name="VCC" type="male">
   <description>PIN1 VCC</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector0pad"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector1" name="D-" type="male">
   <description>PIN2 D-</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector1pad"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector2" name="D+" type="male">
   <description>PIN3 D+</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector2pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector2pad"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector3" name="GND" type="male">
   <description>PIN4 GND</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector3pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector3pad"/>
    </pcbView>
   </views>
  </connector>
 </connectors>
</module>
