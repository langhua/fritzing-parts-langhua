<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="SS34">
 <version>1</version>
 <date>2026-09-17</date>
 <label>D</label>
 <author>Shi Jinghai</author>
 <title>SS34 Schottky Diode (DO-214AC / SMA)</title>
 <tags>
  <tag>SS34</tag>
  <tag>Schottky</tag>
  <tag>diode</tag>
  <tag>SMA</tag>
  <tag>DO-214AC</tag>
 </tags>
 <properties>
  <property name="package">DO-214AC (SMA)</property>
  <property name="family">Schottky Diode</property>
  <property name="pins">2</property>
  <property name="ratings">3.0A / 40V</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/SS34_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/SS34_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/SS34_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/SS34_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector id="connector0" name="K" type="male">
   <description>pin 1 = Cathode</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector0pad"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector1" name="A" type="male">
   <description>pin 2 = Anode</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector1pad"/>
    </pcbView>
   </views>
  </connector>
 </connectors>
</module>
