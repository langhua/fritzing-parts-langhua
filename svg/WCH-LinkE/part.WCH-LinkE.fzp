<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="WCH-LinkE">
 <version>3</version>
 <date>2026-10-18</date>
 <label>LINK</label>
 <author>Shi Jinghai</author>
 <title>WCH-LinkE Debugger/Programmer (USB Type-C, SWD/JTAG/UART)</title>
 <tags>
  <tag>WCH-LinkE</tag>
  <tag>debugger</tag>
  <tag>programmer</tag>
  <tag>SWD</tag>
  <tag>USB Type-C</tag>
 </tags>
 <properties>
  <property name="package">42 x 16.5 x 1.6 mm, USB Type-C, 2x5 2.54mm right-angle header</property>
  <property name="family">Programmer</property>
</properties>
 <description>WCH-LinkE (USB Type-C revision). Breadboard-only part: it is a bench tool, not soldered on the board, so there is no schematic/pcb view. 2x5 2.54mm right-angle header: upper row RX/TX/GND/3V3/RST, lower row CLK/DIO/GND/3V3/5V0. For SWD flashing connect only CLK, DIO and GND; do not connect 3V3.</description>
 <views>
  <iconView>
   <layers image="icon/WCH-LinkE_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/WCH-LinkE_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
 </views>
 <connectors>
  <connector id="connector0" name="RX" type="male">
   <description>上层 RX = 串口 RX</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector1" name="TX" type="male">
   <description>上层 TX = 串口 TX</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="male">
   <description>上层 GND = 地</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector2pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector3" name="3V3" type="male">
   <description>上层 3V3 = 3.3V</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector3pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector4" name="RST" type="male">
   <description>上层 RST = 复位</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector4pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector5" name="CLK" type="male">
   <description>下层 CLK = SWD 时钟 = SWCLK/TCK ★ 接载板 J3.4(SWCLK)</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector5pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector6" name="DIO" type="male">
   <description>下层 DIO = SWD 数据 = SWDIO/TMS ★ 接载板 J3.3(SWDIO)</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector6pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector7" name="GND" type="male">
   <description>下层 GND = 地 ★ 接载板 J3.2(GND)</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector7pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector8" name="3V3" type="male">
   <description>下层 3V3 = 3.3V（接载板时**不要接**：板子自己供电）</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector8pin"/>
    </breadboardView>
   </views>
  </connector>
  <connector id="connector9" name="5V0" type="male">
   <description>下层 5V0 = 5V</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector9pin"/>
    </breadboardView>
   </views>
  </connector>
 </connectors>
 <buses>
  <bus id="GND">
   <nodeMember connectorId="connector2"/>
   <nodeMember connectorId="connector7"/>
  </bus>
  <bus id="3V3">
   <nodeMember connectorId="connector3"/>
   <nodeMember connectorId="connector8"/>
  </bus>
 </buses>
</module>
