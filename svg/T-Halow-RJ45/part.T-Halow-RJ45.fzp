<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="T-Halow-RJ45">
 <version>1</version>
 <date>2026-09-17</date>
 <label>U</label>
 <author>Shi Jinghai</author>
 <title>T-Halow-RJ45 (Taixin HaLow 802.11ah to RJ45 bridge)</title>
