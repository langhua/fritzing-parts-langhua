<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.9b" moduleId="BQ25570">
 <version>1</version>
 <author>Shi Jinghai</author>
 <title>BQ25570</title>
 <label>U</label>
 <date>2026-10-17</date>
 <tags><tag>IC</tag><tag>PMIC</tag><tag>energy harvesting</tag><tag>TI</tag><tag>VQFN-20</tag></tags>
 <properties>
  <property name="family">TI energy harvester</property>
  <property name="chip">BQ25570</property>
  <property name="pins">20</property>
  <property name="part number">BQ25570RGR</property>
  <property name="package">VQFN-20 (RGR)</property>
 </properties>
 <description>Texas Instruments bq25570 nanopower boost charger with MPPT plus nano-power buck converter, VQFN-20 RGR 3.5x3.5 mm / 0.5 mm pitch. The exposed PowerPAD (no pin number) must be soldered and routed to GND; NC pins 9/17 and both VSS pins are tied to it in this footprint. 3x3 0.2 mm thermal vias and the bottom-side thermal land are part of the PCB artwork.</description>
 <views>
  <iconView><layers image="icon/BQ25570_icon.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/BQ25570_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/BQ25570_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/BQ25570_pcb.svg"><layer layerId="silkscreen"/><layer layerId="copper0"/><layer layerId="copper1"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="GND" type="male">
   <description>pin 1 - power ground for the boost charger / module terminal GND</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector0pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="TB1-INPUT+" type="male">
   <description>pin 2 - DC input from the harvesting source (>= 4.7 uF to pin 1) / module terminal TB1-INPUT+</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector1pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="VOC_SAMP" type="male">
   <description>pin 3 - MPPT sampling pin (VSTOR = 80%, GND = 50%, or divider)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector3" name="VREF_SAMP" type="male">
   <description>pin 4 - MPPT sample-and-hold capacitor (0.01 uF low leakage)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector3pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector4" name="EN" type="male">
   <description>pin 5 - active-low enable - connect to GND to enable the IC / module terminal EN</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector4pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector5" name="V_EN" type="male">
   <description>pin 6 - active-high buck enable - connect to VSTOR to enable / module terminal V_EN</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector5pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector5pin" terminalId="connector5terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector5pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector6" name="VBAT_OV" type="male">
   <description>pin 7 - VBAT overvoltage threshold divider (VRDIV / GND)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector6pin" terminalId="connector6terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector6pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector7" name="VRDIV" type="male">
   <description>pin 8 - divider bias output (high side of the resistor dividers)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector7pin" terminalId="connector7terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector7pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector8" name="NC" type="male">
   <description>pin 9 - no connect - tie to the PowerPAD (datasheet p34)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector8pin" terminalId="connector8terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector8pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector9" name="OK_HYST" type="male">
   <description>pin 10 - VBAT_OK hysteresis divider (VRDIV / GND)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector9pin" terminalId="connector9terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector9pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector10" name="OK_PROG" type="male">
   <description>pin 11 - VBAT_OK threshold divider (VRDIV / GND)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector10pin" terminalId="connector10terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector10pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector11" name="VOUT_SET" type="male">
   <description>pin 12 - buck output voltage setting divider (VRDIV / GND)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector11pin" terminalId="connector11terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector11pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector12" name="V_OK" type="male">
   <description>pin 13 - battery good digital output (referenced to VSTOR) / module terminal V_OK</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector12pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector12pin" terminalId="connector12terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector12pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector13" name="TB2-OUTPUT+" type="male">
   <description>pin 14 - buck converter output (>= 22 uF to pin 15) / module terminal TB2-OUTPUT+</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector13pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector13pin" terminalId="connector13terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector13pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector14" name="VSS" type="male">
   <description>pin 15 - power ground for the buck converter / analog ground</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector14pin" terminalId="connector14terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector14pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector15" name="LBUCK" type="male">
   <description>pin 16 - buck inductor (>= 4.7 uH to pin 14)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector15pin" terminalId="connector15terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector15pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector16" name="NC" type="male">
   <description>pin 17 - no connect - tie to the PowerPAD (datasheet p34)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector16pin" terminalId="connector16terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector16pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector17" name="J1-BAT+" type="male">
   <description>pin 18 - storage element (super-cap / battery), >= 100 uF / module terminal J1-BAT+</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector17pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector17pin" terminalId="connector17terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector17pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector18" name="VSTOR" type="male">
   <description>pin 19 - boost charger output (>= 4.7 uF + 0.1 uF to pin 1)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector18pin" terminalId="connector18terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector18pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector19" name="LBOOST" type="male">
   <description>pin 20 - boost inductor (22 uH to pin 2)</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector19pin" terminalId="connector19terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector19pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector20" name="PowerPAD" type="male">
   <description>exposed thermal pad (datasheet: Thermal Pad / TI PowerPAD, no pin number) - solder it and route it to GND; 3x3 0.2 mm thermal vias and the bottom copper land are part of the footprint</description>
   <views>
    <schematicView><p layer="schematic" svgId="connector20pin" terminalId="connector20terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector20pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector21" name="TB2-OUTPUT-" type="male">
   <description>module terminal TB2-OUTPUT- (bottom pin, same net as VSS)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector21pin"/></breadboardView>
   </views>
  </connector>
  <connector id="connector22" name="J1-BAT-" type="male">
   <description>module terminal J1-BAT- (bottom pin, same net as VSS)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector22pin"/></breadboardView>
   </views>
  </connector>
  <connector id="connector23" name="TB1-INPUT-" type="male">
   <description>module terminal TB1-INPUT- (bottom pin, same net as VSS)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector23pin"/></breadboardView>
   </views>
  </connector>
  <connector id="connector24" name="PowerPAD_VIA1" type="male">
   <description>thermal via 1 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector24pad"/>
    <p layer="copper1" svgId="connector24pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector25" name="PowerPAD_VIA2" type="male">
   <description>thermal via 2 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector25pad"/>
    <p layer="copper1" svgId="connector25pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector26" name="PowerPAD_VIA3" type="male">
   <description>thermal via 3 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector26pad"/>
    <p layer="copper1" svgId="connector26pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector27" name="PowerPAD_VIA4" type="male">
   <description>thermal via 4 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector27pad"/>
    <p layer="copper1" svgId="connector27pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector28" name="PowerPAD_VIA5" type="male">
   <description>thermal via 5 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector28pad"/>
    <p layer="copper1" svgId="connector28pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector29" name="PowerPAD_VIA6" type="male">
   <description>thermal via 6 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector29pad"/>
    <p layer="copper1" svgId="connector29pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector30" name="PowerPAD_VIA7" type="male">
   <description>thermal via 7 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector30pad"/>
    <p layer="copper1" svgId="connector30pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector31" name="PowerPAD_VIA8" type="male">
   <description>thermal via 8 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector31pad"/>
    <p layer="copper1" svgId="connector31pad"/>
   </pcbView></views>
  </connector>
  <connector id="connector32" name="PowerPAD_VIA9" type="male">
   <description>thermal via 9 of the PowerPAD copper - plated through, same net as the PowerPAD, routable on both copper layers</description>
   <views><pcbView>
    <p layer="copper0" svgId="connector32pad"/>
    <p layer="copper1" svgId="connector32pad"/>
   </pcbView></views>
  </connector>
 </connectors>
 <buses>
  <bus id="GND">
   <nodeMember connectorId="connector0"/>
