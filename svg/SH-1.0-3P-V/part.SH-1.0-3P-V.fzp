<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="SH-1.0-3P-V">
 <version>1</version>
 <author>Shi Jinghai</author>
 <title>1.0mm 3P vertical SMD socket (SH1.0-3P-LT)</title>
 <label>J</label>
 <date>2026-09-24</date>
 <tags><tag>connector</tag><tag>SH1.0</tag><tag>socket</tag><tag>3P</tag><tag>vertical</tag><tag>SMD</tag></tags>
 <properties>
  <property name="family">connector</property>
  <property name="series">SH1.0</property>
  <property name="part number">SH1.0-3P-LT</property>
  <property name="pitch">1mm</property>
  <property name="pins">3</property>
  <property name="mounting">SMD vertical</property>
 </properties>
 <description>SH1.0 1mm 3P vertical SMD socket (SH1.0-3P-LT), board side. Breadboard view = green adapter board with 3 header pins on the 2.54mm grid (the SMD socket itself cannot plug into a breadboard). Pads follow the manufacturer drawing.</description>
 <views>
  <iconView><layers image="icon/SH-1.0-3P-V_icon.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/SH-1.0-3P-V_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/SH-1.0-3P-V_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/SH-1.0-3P-V_pcb.svg"><layer layerId="copper1"/><layer layerId="silkscreen"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="1" type="male">
   <description>pin 1</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector0pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="2" type="male">
   <description>pin 2</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector1pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="3" type="male">
   <description>pin 3</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
</connectors>
</module>
