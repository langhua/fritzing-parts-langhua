    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector3" name="VDD" type="male">
   <description>pin 4 - supply 2.5 / 3.3 / 5 V</description>
   <views>
