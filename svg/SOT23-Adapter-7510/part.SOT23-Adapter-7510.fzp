<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.9b" moduleId="SOT23-Adapter-7510">
 <version>1</version>
 <author>Shi Jinghai</author>
 <title>SOT-23 Adapter 7.5x10</title>
 <label>U</label>
 <date>2026-11-27</date>
 <tags><tag>adapter</tag><tag>SOT-23</tag><tag>SOT23</tag><tag>breakout</tag><tag>2.54mm</tag><tag>through-hole</tag></tags>
 <properties>
  <property name="family">breakout board</property>
  <property name="package">THT 3-pin (2.54mm)</property>
  <property name="size">7.5 x 10 mm</property>
  <property name="pin order">2 3 1 (left to right)</property>
  <property name="part number">SOT23-Adapter-7510</property>
 </properties>
 <description>SOT-23 to 2.54 mm breakout carrier, 7.5 x 10 mm. The three through-hole pads sit in ONE breadboard row; the order from left to right is 2-3-1 (pad 1 = SOT-23 pin 1, pad 2 = pin 2, pad 3 = pin 3).</description>
 <views>
  <iconView>
   <layers image="icon/SOT23-Adapter-7510_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/SOT23-Adapter-7510_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/SOT23-Adapter-7510_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/SOT23-Adapter-7510_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="copper0"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="1" type="male">
   <description>Pad 1 (right) - SOT-23 pin 1</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="2" type="male">
   <description>Pad 2 (left) - SOT-23 pin 2</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="3" type="male">
   <description>Pad 3 (middle) - SOT-23 pin 3</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
 </connectors>
</module>
