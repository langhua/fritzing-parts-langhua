<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.3" moduleId="DSIC01LS-P">
 <version>1</version>
 <date>2026-09-17</date>
 <label>SW</label>
 <author>Shi Jinghai</author>
 <title>DSIC01LS-P DIP Switch (SMD, 1 position, SPST)</title>
 <tags>
  <tag>DSIC01LS-P</tag>
  <tag>DIP switch</tag>
  <tag>switch</tag>
  <tag>SMD</tag>
  <tag>SPST</tag>
  <tag>XKB</tag>
 </tags>
 <properties>
  <property name="package">SMD DIP-2 (4.06 x 6.20 mm)</property>
  <property name="family">DIP Switch</property>
  <property name="pins">2</property>
  <property name="ratings">25mA / 24V DC</property>
 </properties>
 <views>
  <breadboardView>
   <layers image="breadboard/DSIC01LS-P_breadboard.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/DSIC01LS-P_schematic.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/DSIC01LS-P_pcb.svg">
    <layer layerId="copper1"/>
    <layer layerId="silkscreen"/>
   </layers>
  </pcbView>
  <iconView>
   <layers image="icon/DSIC01LS-P_icon.svg">
    <layer layerId="icon"/>
   </layers>
  </iconView>
 </views>
 <connectors>
  <connector id="connector0" name="1" type="male">
   <description>pin 1 = SPST terminal 1 (side marked '1')</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector0pin"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector1" name="2" type="male">
   <description>pin 2 = SPST terminal 2 (other end)</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector1pin"/>
    </pcbView>
   </views>
  </connector>
 </connectors>
</module>
